<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash + post-splash theme. Compose owns the actual color scheme. -->
    <style name="Theme.SoundGuard" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0F172A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SoundGuard.Main</item>
    </style>

    <style name="Theme.SoundGuard.Main" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
